<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101B32"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_partner_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="For Your person"
        android:textColor="#FFF1F5"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="New canvas moment waiting for you."
        android:textColor="#C5D0EA"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/widget_drawing_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_name"
        android:scaleType="centerCrop" />
</LinearLayout>
